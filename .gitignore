node_modules/
# dist/ is committed. pi installs git packages with --omit=dev, so prepare
# cannot rely on typescript being present. A git install must already contain dist/.
*.tgz
# Machine-local Pi settings, credentials, and background task data
.pi/
.pi-intercom/*.tmp
.pi-intercom/config.lock
.pi-intercom/logs/
.pi-intercom/reports/
# Local monitor pane ownership and uncertain-launch fences (not agent config)
.pi-intercom/monitor-*.json
.pi-intercom/monitor-*.json.lock
# Shared .pi-intercom/config.json is intentionally tracked.
